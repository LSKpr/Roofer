{
  "name": "roofer",
  "version": "0.1.0",
  "private": true,
  "description": "Wykrywanie dachów azbestowych dla urzędów gmin",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "dev": "pnpm -r --parallel dev",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
