# Skopiuj do .env. Jeden plik obsluguje backend (pydantic-settings) i frontend (Vite, envDir '..').

# Baza. Port 5433, bo 5432 zajmuje sierocy kontener starego stacku.
POSTGRES_PASSWORD=roofer
DATABASE_URL=postgresql://roofer:roofer@localhost:5433/roofer

# Backend
API_PORT=8001
# CORS ma znaczenie tylko dla klienta, ktory nie idzie przez proxy dev servera.
CORS_ORIGINS=http://localhost:5173

# Dev server Vite przekazuje /api tutaj.
API_PROXY_TARGET=http://127.0.0.1:8001
# Ustaw tylko, gdy frontend ma wolac backend na innym origin, zamiast przez proxy.
# VITE_API_BASE_URL=

# Ocena pokrycia dachu. `mock` to jawnie oznaczona atrapa, `none` wylacza ocene, `model` wola
# zewnetrzne API. Przy `model` bez adresu albo bez tokenu dostawca degraduje sie do „nie wiemy",
# zamiast pytac i dostawac 401.
PREDICTION_PROVIDER=mock
# Port 8010, nie 8001: na 8001 stoi nasz wlasny backend. Adres publiczny tamtej instancji jest
# zablokowany przez Security Group, wiec idziemy tunelem:
#   ssh -N -L 8010:127.0.0.1:8000 student@<host>
PREDICTION_API_URL=http://127.0.0.1:8010
# SEKRET — wpisz tylko w swoim .env, nigdy tutaj. Plik .env jest w .gitignore.
PREDICTION_API_TOKEN=
# Tamta instancja dopuszcza 10 zapytan na minute i jedno naraz, a karta budynku pyta przy kazdym
# kliknieciu — stad cache po osm_id i odstep miedzy zapytaniami.
PREDICTION_TIMEOUT_S=60
PREDICTION_CACHE_TTL_S=3600
PREDICTION_MIN_INTERVAL_S=6
