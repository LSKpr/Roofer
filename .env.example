# Skopiuj do .env i uzupełnij. Nie commituj .env.

# --- MySQL (docker-compose) ---
MYSQL_ROOT_PASSWORD=roofer
MYSQL_DATABASE=roofer
MYSQL_USER=roofer
MYSQL_PASSWORD=roofer
MYSQL_PORT=3306

# --- Backend ---
DATABASE_URL="mysql://roofer:roofer@localhost:3306/roofer"
PORT=4000
